{
  "name": "p2party.com",
  "private": true,
  "version": "0.0.0",
  "description": "The open-source p2party WebRTC mesh client",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2party/p2party.com.git"
  },
  "homepage": "https://p2party.com",
  "bugs": {
    "url": "https://github.com/p2party/p2party.com/issues"
  },
  "packageManager": "npm@12.2.3",
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=12.2.3"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "start": "npm run dev",
    "typecheck": "node node_modules/typescript-native7/bin/tsc -b --pretty false",
    "build": "npm run typecheck && npm run build:client && npm run build:server && npm run prerender",
    "test": "bun test && npm run test:wallet",
    "test:wallet": "node --test wallet/tests/*.node.mjs",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings 0",
    "provenance:check": "node scripts/verifyLocalDependency.mjs",
    "e2e": "node e2e/run.mjs",
    "e2e:native-csp": "npm run build:native && node e2e/native-csp.mjs",
    "upload": "npm run build && node --env-file=.env scripts/uploadAllToS3.mjs",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs",
    "build:client": "npm run build:wallet && vite build",
    "build:native": "npm run build:wallet && vite build --mode native",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build:wallet": "node scripts/buildWallet.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@p2party/ledger-client": "file:public/downloads/testnet-1/p2party-ledger-client-0.1.0-testnet.0.tgz",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "jose": "6.2.18",
    "p2party": "file:vendor/p2party-0.15.2.tgz",
    "qr": "0.7.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "react-redux": "^9.3.1",
    "react-router": "8.5.3",
    "remark-gfm": "4.0.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome-team/capacitor-file-opener": "^8.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "typescript-native7": "npm:typescript@7.0.2",
    "vite": "^8.4.0"
  }
}
