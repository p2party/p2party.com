{
  "name": "p2party.com",
  "private": true,
  "version": "0.0.0",
  "description": "The open-source p2party WebRTC mesh client",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2party/p2party.com.git"
  },
  "homepage": "https://p2party.com",
  "bugs": {
    "url": "https://github.com/p2party/p2party.com/issues"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.6.2"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "start": "npm run dev",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run typecheck && vite build && npm run prerender",
    "test": "bun test",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings 0",
    "provenance:check": "node scripts/verifyLocalDependency.mjs",
    "e2e": "node e2e/run.mjs",
    "upload": "npm run build && node --env-file=.env scripts/uploadAllToS3.mjs",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@wavesurfer/react": "^1.0.12",
    "class-validator": "^0.15.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "p2party": "file:vendor/p2party-0.14.0.tgz",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "react-pdf": "^10.4.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "4.0.1",
    "usehooks-ts": "^3.1.1",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@capacitor-community/safe-area": "^8.0.1",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome-team/capacitor-file-opener": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/wavesurfer.js": "^6.0.12",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@isaacs/brace-expansion": "5.0.1",
    "@xmldom/xmldom": "0.8.13",
    "esbuild": "0.28.1",
    "flatted": "3.4.3",
    "glob": "11.1.0",
    "picomatch": "4.0.5",
    "postcss": "8.5.22",
    "rollup": "4.62.2",
    "tar": "7.5.21"
  }
}
