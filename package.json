{
  "name": "p2party.com",
  "private": true,
  "version": "0.0.0",
  "description": "The open-source p2party WebRTC mesh client",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2party/p2party.com.git"
  },
  "homepage": "https://p2party.com",
  "bugs": {
    "url": "https://github.com/p2party/p2party.com/issues"
  },
  "packageManager": "npm@12.2.3",
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=12.2.3"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "start": "npm run dev",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run typecheck && npm run build:client && npm run build:server && npm run prerender",
    "test": "bun test",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings 0",
    "provenance:check": "node scripts/verifyLocalDependency.mjs",
    "e2e": "node e2e/run.mjs",
    "e2e:native-csp": "npm run build:native && node e2e/native-csp.mjs",
    "upload": "npm run build && node --env-file=.env scripts/uploadAllToS3.mjs",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs",
    "build:client": "vite build",
    "build:native": "vite build --mode native",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "p2party": "file:vendor/p2party-0.14.10.tgz",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "react-redux": "^9.3.1",
    "react-router": "8.5.3",
    "remark-gfm": "4.0.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@capacitor-community/safe-area": "^8.0.1",
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome-team/capacitor-file-opener": "^8.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8"
  },
  "overrides": {
    "@humanfs/node": "0.17.0",
    "@isaacs/brace-expansion": "5.0.1",
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "5.1.0",
    "esbuild": "0.28.2",
    "flatted": "3.4.4",
    "glob": "14.0.6",
    "nanoid": "6.0.2",
    "picomatch": "4.0.7",
    "postcss": "8.5.33",
    "rollup": "4.68.8",
    "tar": "7.5.24"
  }
}
