# Deployment-only credentials used by scripts/uploadAllToS3.mjs.
# Never prefix these with VITE_: browser-exposed environment variables are public.
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
# Destructive pruning is opt-in and only runs after every upload succeeds.
AWS_S3_PRUNE=false
# Keep true in production. Set false only until the Android signing fingerprint
# has been copied from docs/assetlinks.json.example into public/.well-known/.
AWS_S3_REQUIRE_ANDROID_APP_LINKS=true
